---
import Layout from "../layouts/layout.astro";
import Panel from "../components/Panel.astro";
import { siteScreenshot } from "../helper/site-screenshot.js";
import { fixScreenshotPath } from "../helper/fix-screenshot-path.js";
import ALink from "../components/link.astro";
import { projects } from "../data/projects.ts";


// dev 時はここはコメントアウト・処理が重たいなどなど
// const screenshots = projects.map(({ hasScreenshot, src }) => {
//     if (hasScreenshot) return siteScreenshot(src, `public/${fixScreenshotPath(src)}`);
// });
// await Promise.all(screenshots);
---

<Layout title="作品について" description="ウェブアプリや画像作品。">
    <div class="page">
        <h1 class="page-title">作ったものたち</h1>

        <div class="gallery">
            {
                projects.map(({ title, hasScreenshot, src, alt, description, links = [] }) => (
                    <Panel title={title} tag="article">
                        <div class="work-card">
                            <a
                                href={src}
                                target="_blank"
                                aria-label={`${title}${hasScreenshot ? "のサイトへ移動" : "を原寸で表示"}`}
                            >
                                <img
                                    src={hasScreenshot ? `/${fixScreenshotPath(src)}` : src}
                                    alt={alt}
                                    loading="lazy"
                                />
                            </a>
                            <div class="descriptions">
                                <h3>なんで作ったの？</h3>
                                <p>{description}</p>
                                {links.length ? <h3>リンク</h3>
                                  <div class="links">
                                    {links.map(({ href, label, external }) => (
                                    <ALink href={href} label={label} external={external} />
                                ))}</div> : ""}
                            </div>
                        </div>
                    </Panel>
                ))
            }
        </div>
    </div>
</Layout>

<style>
    .gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }
    .work-card {
        container-type: inline-size;
    }
    .work-card img {
        display: block;
        width: 100%;
        aspect-ratio: 16/10;
        background: #eee;
        object-fit: contain;
    }
    .work-card .descriptions {
        width: 100%;
        height: 100%;
        padding: 10px;
        margin-top: auto;
    }
    .work-card .descriptions h3 {
        color: #023000;
        margin: 0.5em 0;
        font-size: 1.05rem;
    }
    .work-card .descriptions p {
        line-height: 1.2;
        margin: 0.5em 0;
    }
    .work-card .descriptions .links {
        display: flex;
        gap: 1em;
        flex-wrap: wrap;
    }
    @media (max-width: 800px) {
        .gallery {
            grid-template-columns: 1fr;
        }
    }
</style>
