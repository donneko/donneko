---
import Layout from "../layouts/Layout.astro";
import Panel from "../components/Panel.astro";
import InfoBox from "../components/info-box.astro";
---

<Layout
    title="404 - ページが見つかりません"
    description="お探しのページは見つかりませんでした。"
    noindex
>
    <div class="page">
        <Panel title="エラー" tag="div" heading="p">
            <div class="info-body">
                <InfoBox type="warning">
                    <h1>404 - File Not Found</h1>
                    <p>お探しのページは見つかりませんでした。</p>
                    <p class="info-description">
                        URLが間違っているか、ページが移動・削除された可能性があります。
                    </p>
                </InfoBox>
                <div class="link-box">
                    <a class="link-text" href="/">トップページへ戻る</a>
                </div>
            </div>
        </Panel>
    </div>
</Layout>

<style>
    .info-body {
        padding: 1em;
    }
    .info-body h1 {
        font-weight: normal;
        margin: 0;
        font-size: 1.5em;
        margin-bottom: 0.5em;
    }
    .info-body p {
        margin: 0;
        margin-bottom: 2px;
    }
    .info-description {
        color: #5a5a5a;
        font-size: 0.8em;
    }
    .link-box {
        width: 100%;
        margin: 1.5em 0 0.5em 0;
        display: block;
        text-align: center;
        box-sizing: border-box;
    }
    .link-text {
        display: inline-block;
        padding: 0.2em 1em;
        background-color: #e0e0e0;

        border: 3px #717171 outset;
    }
</style>
