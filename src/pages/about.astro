---
import Layout from "../layouts/Layout.astro";
import Panel from "../components/Panel.astro";
import { profile, languages, history } from "../data/about.ts";
---

<Layout title="私について" description="丼猫のプロフィール、使える言語、これまでの履歴。">
    <div class="page">
        <h1 class="page-title">私について</h1>

        <div class="panels">
            <Panel title="私について">
                <table class="data-table">
                    <thead><tr><th>タイトル</th><th>説明</th></tr></thead>
                    <tbody>
                        {
                            profile.map(([title, value]) => (
                                <tr>
                                    <>
                                        <td>{title}</td>
                                        <td>{value}</td>
                                    </>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </Panel>

            <Panel title="使える言語">
                <table class="data-table">
                    <thead><tr><th>タイトル</th><th>説明</th></tr></thead>
                    <tbody
                        >{
                            languages.map(([title, value]) => (
                                <tr>
                                    <>
                                        <td>{title}</td>
                                        <td>{value}</td>
                                    </>
                                </tr>
                            ))
                        }</tbody
                    >
                </table>
            </Panel>

            <Panel title="履歴">
                <table class="data-table">
                    <thead><tr><th>日にち</th><th>内容</th><th>結果</th></tr></thead>
                    <tbody
                        >{
                            history.map((row) => (
                                <tr>
                                    {row.map((value) => (
                                        <td>{value}</td>
                                    ))}
                                </tr>
                            ))
                        }</tbody
                    >
                </table>
            </Panel>
        </div>
    </div>
</Layout>

<style>
    .panels {
        display: flex;
        flex-direction: column;
        gap: 3em;
    }
    small {
        color: #333;
    }
    td:first-child {
        white-space: nowrap;
    }
</style>
