---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostMeta from "../../components/blog/PostMeta.astro";
import { blogUrl, getPublishedPosts, type BlogPost } from "../../lib/blog";

export const getStaticPaths = (async () => {
    return (await getPublishedPosts()).map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}) satisfies GetStaticPaths;

interface Props {
    post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout title={post.data.title} description={post.data.description}>
    <article class="blog-article">
        <header class="post-header">
            <h1>{post.data.title}</h1>
            <PostMeta post={post} showUpdated />
            <p>{post.data.description}</p>
        </header>
        <div class="markdown-body"><Content /></div>
        <footer class="post-footer"><a href={blogUrl()}>← 記事一覧へ戻る</a></footer>
    </article>
</BlogLayout>
