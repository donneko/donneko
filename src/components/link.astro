---
import type { Link } from "../types/main.type.ts";

interface Props extends Link {}

const { href, label, external } = Astro.props;
---

<a
    href={href}
    class:list={{ "external-link": external }}
    target={external ? "_blank" : undefined}
    rel={external ? "noreferrer" : undefined}
>
    {label}
</a>
