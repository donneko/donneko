---
interface Props {
    title: string;
    tag?: "div" | "section" | "article" | "aside";
    heading?: "h1" | "h2" | "h3" | "h4" | "p";
    "data-category"?: string;
}
const { title, tag, heading, "data-category": category } = Astro.props;
const Element = tag ? tag : "section";
const Heading = heading ? heading : "h2";
---

<Element class="panel" data-category={category}>
    <Heading class="panel-title">{title}</Heading>
    <div class="panel-body"><slot /></div>
</Element>

<style>
    .panel {
        overflow: hidden;
        border: 1px double #111;
        padding: 1px;
        background: #fff;
        box-shadow: 3px 3px 0 rgb(0 0 0 / 20%);
    }
    .panel-title {
        margin: 0;
        padding: 5px 10px;
        background: linear-gradient(#141e6b, #2233bb 10%, #141e6b 90%);
        color: #fff;
        font-size: 1rem;
        text-align: center;
    }
    .panel-body {
        overflow-x: auto;
    }
</style>
