---
interface Props {
  title: string;
  tableTitles: string[];
  tableContents: string[][];
}

const { title, tableTitles, tableContents } = Astro.props;
---

<article>
  <p>{title}</p>

  <table>
    <thead>
      <tr>
        {
          tableTitles.map((title) => (
            <th>{title}</th>
          ))
        }
      </tr>
    </thead>

    <tbody>
      {
        tableContents.map((record) => (
          <tr>
            {
              record.map((content) => (
                <td>{content}</td>
              ))
            }
          </tr>
        ))
      }
    </tbody>
  </table>
</article>

<style>
  article {
    text-align: center;
    width: 90%;
    background-color: #fff;
    border: 1px solid;
    border-collapse: collapse;
  }

  p {
    background: linear-gradient(
      #141e6b,
      #2233bb 10%,
      #141e6b 90%
    );
    color: white;
  }

  table {
    width: 100%;
    text-align: center;
    border-collapse: collapse;
  }

  th {
    background-color: #2233bb;
    color: white;
  }

  th,
  td {
    border: 1px solid;
  }
</style>