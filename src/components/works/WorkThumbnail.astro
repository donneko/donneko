---
import { workThumbnail, type Work } from "../../lib/works";
import { imageAttributes } from "../../lib/images";

interface Props {
    work: Work;
    decorative?: boolean;
    eager?: boolean;
}

const { work, decorative = false, eager = false } = Astro.props;
const thumbnail = workThumbnail(work);
const isVideo = work.data.gallery.some(({ type }) => type === "video");
const attributes = thumbnail ? await imageAttributes(thumbnail.src) : undefined;
---

<span class="work-thumbnail">
    {
        thumbnail ? (
            <img
                {...attributes}
                sizes={
                    attributes && "srcset" in attributes
                        ? decorative
                            ? "(min-width: 1000px) 64px, 76px"
                            : "(min-width: 1280px) 560px, (min-width: 700px) 50vw, calc(100vw - 40px)"
                        : undefined
                }
                alt={decorative ? "" : thumbnail.alt || `${work.data.title}のプレビュー`}
                loading={eager ? "eager" : "lazy"}
                fetchpriority={eager ? "high" : undefined}
                decoding="async"
            />
        ) : (
            <span
                class="work-placeholder"
                role={decorative ? undefined : "img"}
                aria-hidden={decorative ? "true" : undefined}
                aria-label={
                    decorative
                        ? undefined
                        : `${work.data.title}：${isVideo ? "動画作品" : "画像なし"}`
                }
            >
                <span aria-hidden="true">{isVideo ? "▶" : "◇"}</span>
                <small>{isVideo ? "VIDEO" : "NO IMAGE"}</small>
            </span>
        )
    }
</span>
