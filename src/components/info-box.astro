---
interface Props {
    type: "warning" | "info";
}

const { type } = Astro.props;

const imgPath = {
    warning: "/warning-icon.png",
    info: "/info-icon.png",
}[type];
---

<div class="info-box">
    <div class="info-icon-box">
        <img class="info-icon" src={imgPath} />
    </div>

    <div class="info-text-box">
        <slot />
    </div>
</div>

<style>
    .info-box {
        display: flex;
        gap: 1.5em;
        justify-content: center;
        margin: 0.5em 0 1.5em;
    }
    .info-icon-box {
        width: 5em;
        display: flex;
        justify-content: center;
    }
    .info-text-box {
        display: inline-block;
    }
    .info-icon {
        width: 100%;
        max-width: 3em;
        max-height: 5em;
        height: auto;
        display: block;
        image-rendering: pixelated;
        object-fit: contain;
    }
</style>
