---
import Layout from "./Layout.astro";
import "../styles/markdown.css";
import { blogCategories } from "../data/blog";
import { blogUrl, categoryUrl } from "../lib/blog";
import "../styles/blog.css";

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
    <div class="page blog-page">
        <nav class="blog-navigation" aria-label="ブログメニュー">
            <a href={blogUrl()}>記事一覧</a>
        </nav>
        <slot />
        <aside class="blog-categories" aria-label="ブログのカテゴリ">
            <h2>カテゴリ</h2>
            <ul>
                {
                    Object.entries(blogCategories).map(([id, { label, description }]) => (
                        <li>
                            <a href={categoryUrl(id)}>{label}</a>：{description}
                        </li>
                    ))
                }
            </ul>
        </aside>
    </div>
</Layout>
