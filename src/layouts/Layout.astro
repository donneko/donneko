---
import Navigation from "../components/nav.astro";
import "../styles/global.css";
import { imageAttributes, socialImage } from "../lib/images";

interface Props {
    title: string;
    description?: string;
    noindex?: boolean;
    ogImage?: string;
    ogImageAlt?: string;
    ogType?: "website" | "article";
}

const {
    title,
    description = "丼猫の作品や日記をまとめた個人サイトです。",
    noindex = false,
    ogImage,
    ogImageAlt,
    ogType = "website",
} = Astro.props;
const pageTitle = title ? `${title} | 丼猫のウェブサイト` : "丼猫のウェブサイト";
const canonicalURL = new URL(`${Astro.url.pathname.replace(/\/+$/, "")}/`, Astro.site);
const pageImage = socialImage(ogImage);
const shareImage = pageImage ?? socialImage("/ogp/default.png");
const shareAttributes = shareImage ? await imageAttributes(shareImage.path) : undefined;
const shareImageURL = shareAttributes ? new URL(shareAttributes.src, Astro.site).href : undefined;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        {
            noindex ? (
                <meta name="robots" content="noindex, follow" />
            ) : (
                <link rel="canonical" href={canonicalURL.href} />
            )
        }
        {
            !noindex && (
                <>
                    <meta property="og:title" content={pageTitle} />
                    <meta property="og:description" content={description} />
                    <meta property="og:url" content={canonicalURL.href} />
                    <meta property="og:type" content={ogType} />
                    <meta
                        name="twitter:card"
                        content={shareImageURL ? "summary_large_image" : "summary"}
                    />
                    {shareImageURL && shareImage && (
                        <>
                            <meta property="og:image" content={shareImageURL} />
                            <meta property="og:image:width" content={shareAttributes?.width} />
                            <meta property="og:image:height" content={shareAttributes?.height} />
                            <meta
                                property="og:image:alt"
                                content={pageImage ? ogImageAlt || pageTitle : "丼猫のウェブサイト"}
                            />
                        </>
                    )}
                </>
            )
        }
        <link rel="icon" href="/favicon.png" type="image/png" sizes="16x16" />
        <link rel="icon" href="/favicon.ico" sizes="any" />
        <title>{pageTitle}</title>
    </head>
    <body>
        <div class="site-shell">
            <Navigation />
            <main class="site-content"><slot /></main>
        </div>
    </body>
</html>

<style>
    .site-shell {
        display: flex;
        min-height: 100vh;
    }

    .site-name {
        display: block;
        margin-bottom: 30px;
        color: #141e6b;
        font-weight: bold;
        text-align: center;
        text-decoration: none;
    }

    .site-content {
        flex-grow: 1;
        min-width: 0;
        padding: clamp(20px, 4vw, 48px);
        background-image: url("../assets/tana.svg");
        background-size: 15px;
    }

    @media (max-width: 700px) {
        .site-shell {
            flex-direction: column;
        }
    }
</style>
