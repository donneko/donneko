---
interface Props {
  title: string;
}

import NavigationBar from "../components/nav.astro"

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja">
<head>
    <meta charset="UTF-8" />
    <title>{title}</title>
  </head>

  <body>
    <NavigationBar />

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
    body{
        display:flex;
    }
</style>