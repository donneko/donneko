---
import Layout from "./Layout.astro";
import "../styles/markdown.css";
import ImageLightbox from "../components/works/ImageLightbox.astro";
import "../styles/works.css";

interface Props {
    title: string;
    description: string;
    ogImage?: string;
    ogImageAlt?: string;
}

const { title, description, ogImage, ogImageAlt } = Astro.props;
---

<Layout title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt}>
    <div class="page works-page"><slot /></div>
    <ImageLightbox />
</Layout>
